# 复制为 deploy/env/local.admin.env。make admin 在 local.infra.env 之后加载。
# JWT_ACCESS_SECRET 与 LLM_CONFIG_KEY 在 infra，不要在这里再写。

SSO_ISSUER=http://127.0.0.1:8080
SSO_CLIENT_ID=shop-admin
SSO_CLIENT_SECRET=local-only-placeholder-secret
SSO_REDIRECT_URI=http://127.0.0.1:8082/api/admin/v1/auth/callback
# 门户登录页。登出只作废本应用会话，并打开该源的 /account/apps，不结束统一身份会话。
SSO_LOGIN_URL=http://localhost:5173/login
ADMIN_SESSION_SECRET=local-only-admin-session-secret
GOD_VIEW_ENABLED=false

# 管理端打款。缺任一则本次结果为失败，冻结额不动。回调验签公钥在 local.app.env。
PAY_ALIPAY_APP_ID=
PAY_ALIPAY_PRIVATE_KEY=
