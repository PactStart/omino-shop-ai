# 复制为 deploy/env/local.app.env。make app 在 local.infra.env 之后加载。
# 库口令、LLM_CONFIG_KEY、JWT_ACCESS_SECRET、AGENT_INTERNAL_TOKEN 在 infra，不要在这里再写。

JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600
AGENT_BASE_URL=http://127.0.0.1:8190
SMS_PROVIDER=mock
SMS_CHUANGLAN_URL=
SMS_CHUANGLAN_ACCOUNT=
SMS_CHUANGLAN_PASSWORD=
SMS_CHUANGLAN_TEMPLATE_ID=
INVITE_LAND_BASE_URL=http://127.0.0.1:5176
LEGAL_AGREEMENT_URL=
LEGAL_PRIVACY_URL=

# 淘宝客。应用标识或密钥为空则适配器拒绝调用。
UNION_TAOBAO_APP_KEY=
UNION_TAOBAO_APP_SECRET=
# 渠道备案邀请码。空则授权回调不能写入推广身份。
UNION_TAOBAO_INVITE_CODE=
# 在淘宝开放平台登记的回调，须与下面这个完整地址一致。
UNION_TAOBAO_OAUTH_REDIRECT=
# 京东联盟
UNION_JD_APP_KEY=
UNION_JD_APP_SECRET=
# 拼多多
UNION_PDD_CLIENT_ID=
UNION_PDD_CLIENT_SECRET=
# 唯品会
UNION_VIP_APP_KEY=
UNION_VIP_APP_SECRET=
# 大淘客。只用于联想词和热搜词。任一为空则这两个接口返回空列表。
DATAOKE_APP_KEY=
DATAOKE_APP_SECRET=

# 微信支付回调验签。任一为空则拒绝入账。
PAY_WECHAT_PUBLIC_KEY=
PAY_WECHAT_PUBLIC_KEY_ID=
PAY_WECHAT_API_V3_KEY=
# 支付宝回调验签。打款用的 APP_ID 与私钥在 local.admin.env。
PAY_ALIPAY_PUBLIC_KEY=

# 消费者端登录与分享。当前 Java 还未读取，留给后续客户端。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_P8=
GOOGLE_CLIENT_ID=
